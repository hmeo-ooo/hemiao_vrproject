  interferences: []
  designNotes: 
  showTutorialBeforeLevel: 1
  tutorialTitle: 'day 1 '
  tutorialBody: "\u79FB\u52A8\uFF1A\u4F7F\u7528\u3010 W A S D \u3011 \u952E\u63A7\u5236\u89D2\u8272\u5728\u573A\u666F\u4E2D\u79FB\u52A8\u3002\n\r\n\u6293\u53D6\uFF1A\u8D70\u5230\u5783\u573E\u7269\u54C1\u65C1,\u957F\u6309\u3010\u9F20\u6807\u5DE6\u952E\u3011\u5373\u53EF\u6293\u53D6\u7269\u54C1\u3002\n\r\n\u6295\u63B7\uFF1A\u5728\u6293\u53D6\u7269\u54C1\u7684\u72B6\u6001\u4E0B,\u7784\u51C6\u56DE\u6536\u901A\u9053,\u6309\u4E0B\u3010\u9F20\u6807\u53F3\u952E\u3011\u5C06\u7269\u54C1\u6295\u63B7\u51FA\u53BB\u3002\n\n\u94A9\u722A\uFF1A\u5BF9\u51C6\u7269\u54C1\u6309\u3010F\u3011\u952E\u53EF\u4EE5\u5C06\u8FDC\u5904\u7684\u7269\u54C1\u52FE\u5230\u9762\u524D\u3002\n\r\n\u5F97\u5206\u673A\u5236\uFF1A\u5C06\u5783\u573E\u51C6\u786E\u6295\u63B7\u5230\u5BF9\u5E94\u7684\u91D1\u5C5E/\u6709\u673A/\u80FD\u6E90/\u9AD8\u5371\u56DE\u6536\u901A\u9053\u5185,\u5373\u53EF\u8D5A\u53D6\u4FE1\u7528\u70B9\u3002"
