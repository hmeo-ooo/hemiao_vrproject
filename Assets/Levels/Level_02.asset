  tutorialBody: "\u8FDB\u5165\u62C6\u89E3\u6A21\u5F0F\uFF1A\u6293\u53D6\u590D\u5408\u5783\u573E\u540E,\u6309\u4E0B
    \u3010 E \u3011 \u952E\u8FDB\u5165\u7CBE\u7EC6\u64CD\u4F5C\u6A21\u5F0F\u3002\n\r\n\u6495\u626F\u4EFF\u751F\u76AE\u80A4:\uFF1A\u5728\u62C6\u89E3\u6A21\u5F0F\u4E0B,\u6309\u4F4F\u3010\u9F20\u6807\u5DE6\u952E\u3011\u5E76\u62D6\u62FD\u4EFF\u751F\u76AE\u80A4,\u5C06\u5176\u7528\u529B\u6495\u626F\u4E0B\u6765\uFF0C\u518D\u5206\u522B\u6295\u9001\u5783\u573E\u3002\r\n\n\u4F7F\u7528\u5207\u5272\u5200\uFF1A\u5728\u62C6\u89E3\u6A21\u5F0F\u4E0B,\u6309\u4F4F\u3010\u9F20\u6807\u5DE6\u952E\u3011\u62D6\u62FD\u5207\u5272\u5200\u81F3\u7269\u4F53\u8FDE\u63A5\u5904,\u5C06\u5176\u62C6\u89E3\u4E3A\u57FA\u7840\u96F6\u90E8\u4EF6\u3002"
