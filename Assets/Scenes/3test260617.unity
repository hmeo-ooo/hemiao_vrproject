  resumeButtonLabel: {fileID: 369594111}
  pauseTitle: "\u6E38\u620F\u6682\u505C"
  tutorialBody: "\u79FB\u52A8\uFF1AW / A / S / D\n\u8DF3\u8DC3\uFF1A\u7A7A\u683C\n\u6293\u53D6\uFF1A\u957F\u6309\u9F20\u6807\u5DE6\u952E
    \n\u653E\u4E0B\uFF1A\u677E\u5F00\u9F20\u6807\u5DE6\u952E\n\u6295\u63B7\uFF1A\u9F20\u6807\u53F3\u952E\n\u4F7F\u7528\u94A9\u722A\uFF1AF\n\u8FDB\u5165\u62C6\u89E3\u6A21\u5F0F\uFF1AE\n\u6682\u505C\uFF1AEsc\n\u63D0\u524D\u7ED3\u675F\u5173\u5361\uFF1A\u9760\u8FD1\u540A\u5E8A\u6309\u3010E\u3011"
  resumeLabel: "\u56DE\u5230\u6E38\u620F"
  uiFont: {fileID: 0}
--- !u!114 &900300008
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900300001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25789b63abc513444b32c4324fe75632, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  segments:
  - "\u5728\u4E0A\u5C42\u533A\uFF0C\u79D1\u6280\u662F\u6C38\u751F\uFF0C\u662F\u60AC\u6D6E\u5728\u4E91\u7AEF\u7684\u5168\u606F\u795E\u660E\u3002\n\n\u5728\u4E0B\u5C42\u533A\uFF0C\u79D1\u6280\u662F\u8BC5\u5492\uFF0C\u662F\u6D41\u6DCC\u5728\u4E0B\u6C34\u9053\u91CC\u7684\u9713\u8679\u5E9F\u6599\u3002\n\n\u6B22\u8FCE\u6765\u5230\u5E9F\u54C1\u573A\u3002\n\n\u4F60\u662F\u4E00\u540D\u8D1F\u503A\u7D2F\u7D2F\u7684\u201C\u7535\u5B50\u6CD5\u533B\u201D\u3002\u5728\u8FD9\u4E2A\u5934\u9876\u9178\u96E8\u3001\u56DB\u5468\u88AB\u94A2\u94C1\u5783\u573E\u5C71\u5305\u56F4\u7684\u9732\u5929\u8352\u91CE\u91CC\uFF0C\u5806\u6EE1\u4E86\u4ECE\u9AD8\u7A7A\u5DE2\u90FD\u629B\u843D\u7684\u4EFF\u751F\u4EBA\u65AD\u80A2\u3001\u62A5\u5E9F\u7684AI\u5927\u8111\u3001\u8FD8\u6709\u6CBE\u7740\u8840\u7684\u8FDD\u7981\u6838\u5FC3\u3002\u522B\u4EBA\u773C\u91CC\u7684\u7834\u70C2\uFF0C\u662F\u4F60\u4E0D\u88AB\u9AD8\u5229\u8D37\u505A\u6210\u7F50\u5934\u7684\u552F\u4E00\u673A\u4F1A\u3002"
  - "\u522B\u770B\u4E86\uFF0C\u8FD9\u8352\u90CA\u91CE\u5CAD\u7684\uFF0C\u8FDE\u8001\u9F20\u90FD\u4E0D\u4F1A\u8DEF\u8FC7\u3002\n\n\u5F00\u59CB\u5DE5\u4F5C\u5427\uFF0C\u4ECE\u5783\u573E\u5806\u91CC\u627E\u5230\u5E76\u5904\u7406\u66F4\u591A\u7684\u201C\u5783\u573E\u201D\u2014\u2014\u53EA\u8981\u624B\u901F\u591F\u5FEB\uFF0C\u960E\u738B\u5C31\u6536\u4E0D\u8D70\u4F60\u7684\u547D\u3002\n\n\u4ECA\u5929\uFF0C\u662F\u4F60\u7684
    Day 1\u3002\n\n\u7ED9\u4F60\u5B89\u6392\u7684\u4EFB\u52A1\u975E\u5E38\u57FA\u7840\uFF1A\u628A\u5783\u573E\u5206\u522B\u6295\u9001\u5230\u5404\u81EA\u5BF9\u5E94\u7684\u7C89\u788E\u901A\u9053\u3002\n\n\u770B\u6E05\u8FD9\u4E9B\u7834\u70C2\u7684\u6750\u8D28\u2014\u2014\u522B\u628A\u91D1\u5C5E\u6254\u8FDB\u751F\u7269\u9053\uFF01\u5728\u8FD9\u91CE\u5916\u5F04\u9519\u4E86\u53EF\u6CA1\u4EBA\u66FF\u4F60\u64E6\u5C41\u80A1\uFF01"
