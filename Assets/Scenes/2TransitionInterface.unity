--- !u!114 &1119929551
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1119929547}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ea107c647348e645aebaed7d3a45529, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pages:
  - segments:
    - text: '[System Initialization Complete...]


'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    - text: '[Locating: Neon City - Lower Sector 13]


'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    - text: '[Current Location: Reclamation Room 404]


'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    - text: '[Identity: UNIDENTIFIED | Registered Occupation: Cyber-Coroner (Illegal)]'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    separator: 
  - segments:
    - text: '[HIGH-RISK ASSET WARNING]


'
      color: {r: 0.7610062, g: 0, b: 0, a: 0}
      fontSize: 0
      bold: 1
      italic: 0
      fontName: 
    - text: 'Target: Subject #9527 (Player)


'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    - text: 'Initial Debt:'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    - text: ' 1,000,000 Credits


'
      color: {r: 1, g: 0, b: 0.15433693, a: 0}
      fontSize: 0
      bold: 1
      italic: 0
      fontName: 
    - text: 'Current Status: Severely Overdue


'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    - text: Pursuant to the Lower Sector Debt Act, failure to liquidate assets on
        schedule will result in the automatic forfeiture and reclamation of your
        biological organs and cybernetic implants.
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    separator: 
  - segments:
    - text: 'In this city, wherever the neon lights can''t reach... that''s where
        we find a way to survive


'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    - text: 'They call me a ''Cyber-Coroner.'' Sounds fancy, right? In reality, I''m
        just a glorified scavenger cutting open high-tech corpses in a dumpster.
        Prothetic limbs, bricked AI brains, contraband cores dripping with bio-fluid...
        the junk everyone else throws away is my only ticket out of the meat grinder.


'
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    separator: 
  - segments:
    - text: '1,000,000 credits.


'
      color: {r: 1, g: 0, b: 0, a: 0}
      fontSize: 0
      bold: 1
      italic: 0
      fontName: 
    - text: "That\u2019s the bounty Neon City put on my head.\n\n"
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    - text: "Stop staring. That damn lucky cat isn't gonna pray the debt collectors
        away. Flip the switch, get the conveyor belt moving\u2014\nAs long as my
        hands are fast enough, the Grim Reaper can't claim my modified life."
      color: {r: 1, g: 1, b: 1, a: 0}
      fontSize: 0
      bold: 0
      italic: 0
      fontName: 
    separator: 
  fullText: 
  charsPerSecond: 30
  playOnStart: 1
  skipOnClick: 1
  preserveLayout: 1
  segmentSeparator: '\n

'
  typeSound: {fileID: 0}
  audioSource: {fileID: 0}
  autoAdvance: 0
  autoAdvanceDelay: 0.5
  targetText: {fileID: 0}
